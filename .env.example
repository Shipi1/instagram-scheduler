# Copia este archivo como .env y completa el token localmente.
IG_ACCESS_TOKEN=REEMPLAZAR
# Opcional: usuario esperado, sin @. Detecta tokens de otra cuenta.
IG_EXPECTED_USERNAME=
IG_USER_ID=
PUBLIC_MEDIA_URL=
DEFAULT_REEL_CAPTION=

# Orquestador Docker (Compose carga .env en el entorno).
TELEGRAM_BOT_TOKEN=REEMPLAZAR
# Opcional: vNN.N; vacía usa graph.facebook.com sin versión explícita.
GRAPH_API_VERSION=
# false prepara/verifica HTTPS; true publica automáticamente.
PUBLISH_ENABLED=false
PUBLIC_MEDIA_BASE_URL=https://api.shipisnature.com/ig-scheduler/file
HOST_MEDIA_DIR=/home/ubuntu/ig-scheduler-files
# Rutas para Linux local; Compose las sustituye por /data, /media y /config.
DATA_DIR=./data
PUBLIC_MEDIA_DIR=/home/ubuntu/ig-scheduler-files
TELEGRAM_USERS_FILE=./config/telegram_users.json
# Opcional, ruta dentro del contenedor, p.ej. /config/cookies.txt.
INSTAGRAM_COOKIES_FILE=
